# Copiar como ".env" (que está en .gitignore) y ajustar valores reales antes de desplegar a producción.
# En local, docker-compose funciona sin este archivo (usa los defaults del docker-compose.yml).

POSTGRES_DB=appparque
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Development en local; cambiar a Production al desplegar en el VPS.
ASPNETCORE_ENVIRONMENT=Development

# Clave de firma de los JWT. En producción, generar una propia (ej. `openssl rand -base64 48`)
# y NUNCA reutilizar el valor de desarrollo que trae docker-compose.yml por defecto.
JWT_KEY=
