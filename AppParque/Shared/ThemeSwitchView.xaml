<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppParque.Shared.ThemeSwitchView"
             HorizontalOptions="End"
             VerticalOptions="Center">

    <Border StrokeShape="RoundRectangle 12"
            Stroke="{AppThemeBinding Light=#EFE6DC, Dark={StaticResource Gray600}}"
            BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
            WidthRequest="40" HeightRequest="40" Padding="0">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped"/>
        </Border.GestureRecognizers>
        <Label x:Name="IconLabel"
               FontFamily="FreeSolid" FontSize="16"
               TextColor="{AppThemeBinding Light=#2E2013, Dark=White}"
               HorizontalOptions="Center" VerticalOptions="Center"/>
    </Border>
</ContentView>
