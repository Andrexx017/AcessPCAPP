<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:asistente="clr-namespace:AppParque.Features.Asistente"
             x:Class="AppParque.Shared.AsistenteFlotanteView"
             HorizontalOptions="End" VerticalOptions="End"
             InputTransparent="False">

    <!-- Botón flotante del asistente IA: en escritorio/tablet abre un panel de chat pequeño anclado
         a esta misma esquina (no invade el resto de la app); en celular, donde la pantalla ya es
         chica, abre el chat a pantalla completa (ver OnTapped). No es un overlay realmente global
         (la app navega con NavigationPage, no Shell), así que se agrega pantalla por pantalla — ver
         las vistas que lo incluyen. -->
    <Grid RowDefinitions="Auto,Auto" RowSpacing="14" HorizontalOptions="End" VerticalOptions="End">

        <!-- Panel flotante (solo escritorio/tablet). El contenido (AsistenteChatContentView) se crea
             recién al abrir el panel por primera vez (ver OnTapped) y no acá en el XAML: esta vista
             se agrega en casi todas las pantallas, y en celular ese contenido nunca se muestra (ahí
             se navega a AsistenteChatView en su lugar), así que crearlo siempre adelantado solo
             sumaba una llamada a /api/perfil de más en cada pantalla sin usarse para nada. -->
        <Border x:Name="panelChat" Grid.Row="0" IsVisible="False"
                WidthRequest="380" HeightRequest="560"
                StrokeThickness="0" Padding="0"
                HorizontalOptions="End" Margin="0,0,18,0"
                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}">
            <Border.StrokeShape><RoundRectangle CornerRadius="18"/></Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,10" Radius="28" Opacity="0.28"/>
            </Border.Shadow>
        </Border>

        <!-- Burbuja -->
        <Border x:Name="burbuja" Grid.Row="1" StrokeThickness="0"
                BackgroundColor="#0F6B5C"
                WidthRequest="56" HeightRequest="56"
                Padding="0"
                HorizontalOptions="End"
                Margin="0,0,18,18"
                SemanticProperties.Description="Abrir asistente de ayuda">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.25"/>
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTapped"/>
            </Border.GestureRecognizers>
            <Label x:Name="iconoBurbuja" Text="&#xf086;" FontFamily="FreeSolid" FontSize="22"
                   TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Border>
    </Grid>
</ContentView>
