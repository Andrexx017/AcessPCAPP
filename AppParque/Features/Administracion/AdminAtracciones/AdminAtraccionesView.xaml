<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:AppParque.Shared"
             x:Class="AppParque.Features.Administracion.AdminAtracciones.AdminAtraccionesView"
             Title="Catálogo de atracciones"
             BackgroundColor="{AppThemeBinding Light=#f5f7fa, Dark={StaticResource OffBlack}}">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- barra superior -->
            <Border Grid.Row="0"
                    Padding="20,14"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                        <Label Text="Catálogo de atracciones" FontAttributes="Bold" FontSize="18.5"
                               TextColor="{AppThemeBinding Light=#1f2430, Dark=White}"/>
                        <Label Text="{Binding Subtitulo}" FontSize="12"
                               TextColor="{AppThemeBinding Light=#8b93a1, Dark={StaticResource Gray400}}"/>
                    </VerticalStackLayout>

                    <Border Grid.Column="1" VerticalOptions="Center"
                            Stroke="{AppThemeBinding Light=#e3e7ec, Dark={StaticResource Gray600}}" StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray950}}"
                            Padding="10,0" HeightRequest="40" WidthRequest="200">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                        <Entry x:Name="entryBuscar" Placeholder="Buscar atracción..." FontSize="13.5"
                               VerticalOptions="Center" TextChanged="OnBuscarTextChanged"/>
                    </Border>

                    <shared:ThemeSwitchView Grid.Column="2" VerticalOptions="Center"/>

                    <Button Grid.Column="3"
                            Text="+ Nueva atracción"
                            Clicked="OnNuevaAtraccionClicked"
                            BackgroundColor="#0F6B5C" TextColor="White" FontAttributes="Bold" FontSize="13.5"
                            CornerRadius="10" HeightRequest="40" Padding="14,0"/>
                </Grid>
            </Border>

            <!-- filtro por intensidad -->
            <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="7" Padding="20,12">
                    <Border x:Name="chipTodas"
                            BackgroundColor="#15191E" StrokeThickness="0" Padding="13,0" HeightRequest="32">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFiltroIntensidadTapped" CommandParameter="todas"/></Border.GestureRecognizers>
                        <Label Text="Todas" FontSize="12" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                    </Border>
                    <Border x:Name="chipBaja" BackgroundColor="Transparent"
                            Stroke="{AppThemeBinding Light=#e3e7ec, Dark={StaticResource Gray600}}" StrokeThickness="1" Padding="13,0" HeightRequest="32">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFiltroIntensidadTapped" CommandParameter="baja"/></Border.GestureRecognizers>
                        <Label Text="Baja" FontSize="12" FontAttributes="Bold" TextColor="#5A6472" VerticalOptions="Center"/>
                    </Border>
                    <Border x:Name="chipMedia" BackgroundColor="Transparent"
                            Stroke="{AppThemeBinding Light=#e3e7ec, Dark={StaticResource Gray600}}" StrokeThickness="1" Padding="13,0" HeightRequest="32">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFiltroIntensidadTapped" CommandParameter="media"/></Border.GestureRecognizers>
                        <Label Text="Media" FontSize="12" FontAttributes="Bold" TextColor="#5A6472" VerticalOptions="Center"/>
                    </Border>
                    <Border x:Name="chipAlta" BackgroundColor="Transparent"
                            Stroke="{AppThemeBinding Light=#e3e7ec, Dark={StaticResource Gray600}}" StrokeThickness="1" Padding="13,0" HeightRequest="32">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFiltroIntensidadTapped" CommandParameter="alta"/></Border.GestureRecognizers>
                        <Label Text="Alta" FontSize="12" FontAttributes="Bold" TextColor="#5A6472" VerticalOptions="Center"/>
                    </Border>
                    <Border x:Name="chipExtrema" BackgroundColor="Transparent"
                            Stroke="{AppThemeBinding Light=#e3e7ec, Dark={StaticResource Gray600}}" StrokeThickness="1" Padding="13,0" HeightRequest="32">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFiltroIntensidadTapped" CommandParameter="extrema"/></Border.GestureRecognizers>
                        <Label Text="Extrema" FontSize="12" FontAttributes="Bold" TextColor="#5A6472" VerticalOptions="Center"/>
                    </Border>
                    <Border x:Name="chipCultural" BackgroundColor="Transparent"
                            Stroke="{AppThemeBinding Light=#e3e7ec, Dark={StaticResource Gray600}}" StrokeThickness="1" Padding="13,0" HeightRequest="32">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFiltroIntensidadTapped" CommandParameter="cultural"/></Border.GestureRecognizers>
                        <Label Text="Cultural" FontSize="12" FontAttributes="Bold" TextColor="#5A6472" VerticalOptions="Center"/>
                    </Border>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- grid de tarjetas -->
            <ScrollView Grid.Row="2">
                <FlexLayout Padding="20,4,20,24" Wrap="Wrap" JustifyContent="Start"
                            BindableLayout.ItemsSource="{Binding Atracciones}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border WidthRequest="256" Margin="0,0,14,14" Padding="0"
                                    Opacity="{Binding Opacidad}"
                                    Stroke="{AppThemeBinding Light=#e3e7ec, Dark={StaticResource Gray600}}" StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAtraccionTapped"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout>
                                    <BoxView HeightRequest="6" Color="{Binding IntensidadBanda}"/>
                                    <VerticalStackLayout Padding="14,12" Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <Label Grid.Column="0" Text="{Binding Nombre}" FontAttributes="Bold" FontSize="15.5"
                                                   LineBreakMode="TailTruncation"
                                                   TextColor="{AppThemeBinding Light=#1f2430, Dark=White}"/>
                                            <Border Grid.Column="1" BackgroundColor="{Binding IntensidadFondo}" StrokeThickness="0" Padding="6,3" VerticalOptions="Start">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                                                <Label Text="{Binding IntensidadTexto}" FontSize="9.5" FontAttributes="Bold" TextColor="{Binding IntensidadColorTexto}"/>
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding Alturas}" FontSize="11.5"
                                               TextColor="{AppThemeBinding Light=#8b93a1, Dark={StaticResource Gray400}}"/>
                                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#edeff3, Dark={StaticResource Gray600}}" Margin="0,2"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                                <Ellipse Fill="{Binding EstadoColor}" WidthRequest="7" HeightRequest="7"/>
                                                <Label Text="{Binding EstadoTexto}" FontSize="11.5" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#1f2430, Dark=White}"/>
                                            </HorizontalStackLayout>
                                            <Border Grid.Column="1" BackgroundColor="{Binding BloqueosFondo}" StrokeThickness="0" Padding="7,2">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="7"/></Border.StrokeShape>
                                                <Label Text="{Binding BloqueosTexto}" FontSize="11" FontAttributes="Bold" TextColor="{Binding BloqueosColorTexto}"/>
                                            </Border>
                                        </Grid>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </ScrollView>

            <ActivityIndicator Grid.Row="2"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#0F6B5C"
                               HorizontalOptions="Center" VerticalOptions="Start" Margin="0,40,0,0"/>
        </Grid>

        <!-- Modal de alta/edición de atracción: overlay sobre la lista en vez de navegar a otra pantalla -->
        <Grid x:Name="modalOverlay"
              IsVisible="False"
              BackgroundColor="#99000000">
            <Border Margin="20"
                    Padding="0"
                    MaximumWidthRequest="560"
                    MaximumHeightRequest="680"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}">
                <Border.StrokeShape><RoundRectangle CornerRadius="18"/></Border.StrokeShape>

                <Grid RowDefinitions="Auto,Auto,*,Auto">

                    <!-- encabezado -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,auto" Padding="22,18,14,0">
                        <Label Grid.Column="0" x:Name="lblModalTitulo" Text="Nueva atracción" FontAttributes="Bold" FontSize="18.5" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Text="✕" FontSize="16" Padding="8"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light=#8b93a1, Dark={StaticResource Gray400}}"
                                Clicked="OnCerrarModalClicked"/>
                    </Grid>

                    <!-- pestañas -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="24" Padding="22,10,22,0">
                        <VerticalStackLayout Grid.Column="0" Spacing="8">
                            <Button x:Name="btnTabDatos" Text="Datos generales" Clicked="OnTabDatosClicked"
                                    BackgroundColor="Transparent" TextColor="#0F6B5C" FontAttributes="Bold" FontSize="13.5"
                                    Padding="0" HeightRequest="26" HorizontalOptions="Start"/>
                            <BoxView x:Name="indicadorDatos" HeightRequest="2.5" BackgroundColor="#0F6B5C"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Button x:Name="btnTabRestricciones" Text="Restricciones" Clicked="OnTabRestriccionesClicked"
                                    BackgroundColor="Transparent" TextColor="#8b93a1" FontAttributes="Bold" FontSize="13.5"
                                    Padding="0" HeightRequest="26" HorizontalOptions="Start"/>
                            <BoxView x:Name="indicadorRestricciones" HeightRequest="2.5" BackgroundColor="Transparent"/>
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView Grid.Row="1" HeightRequest="1" VerticalOptions="End"
                             BackgroundColor="{AppThemeBinding Light=#edeff3, Dark={StaticResource Gray600}}"/>

                    <!-- contenido -->
                    <ScrollView Grid.Row="2">
                        <Grid Padding="22,16">

                            <!-- pestaña: datos generales -->
                            <VerticalStackLayout x:Name="panelDatos" Spacing="14">

                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Nombre" FontAttributes="Bold" FontSize="12.5"/>
                                    <Entry x:Name="entryNombre" Placeholder="Montaña Rusa Cóndor" HeightRequest="42"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Descripción" FontAttributes="Bold" FontSize="12.5"/>
                                    <Editor x:Name="editorDescripcion" AutoSize="TextChanges" MinimumHeightRequest="70" Placeholder="Descripción opcional"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="5">
                                    <Label Text="URL de imagen" FontAttributes="Bold" FontSize="12.5"/>
                                    <Entry x:Name="entryImagenUrl" Placeholder="https://..." Keyboard="Url" HeightRequest="42"
                                           TextChanged="OnImagenUrlTextChanged"/>

                                    <Grid x:Name="previewImagenVacio" HeightRequest="96"
                                          BackgroundColor="{AppThemeBinding Light=#fbfcfd, Dark={StaticResource Gray950}}">
                                        <Label Text="Sin imagen cargada · se usará en la guía PDF del visitante"
                                               FontSize="11.5" HorizontalTextAlignment="Center" Margin="20,0"
                                               TextColor="{AppThemeBinding Light=#8b93a1, Dark={StaticResource Gray400}}"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Grid>
                                    <Image x:Name="imgPreview" HeightRequest="96" Aspect="AspectFill" IsVisible="False"/>
                                </VerticalStackLayout>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                                        <Label Text="Altura mínima (cm)" FontAttributes="Bold" FontSize="12.5"/>
                                        <Entry x:Name="entryAlturaMinima" Keyboard="Numeric" Placeholder="120" HeightRequest="42"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                                        <Label Text="Altura máxima (cm)" FontAttributes="Bold" FontSize="12.5"/>
                                        <Entry x:Name="entryAlturaMaxima" Keyboard="Numeric" Placeholder="200" HeightRequest="42"/>
                                    </VerticalStackLayout>
                                </Grid>

                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Intensidad" FontAttributes="Bold" FontSize="12.5"/>
                                    <Picker x:Name="pickerIntensidad" Title="Selecciona la intensidad" HeightRequest="42" VerticalOptions="Center">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>Baja</x:String>
                                                <x:String>Media</x:String>
                                                <x:String>Alta</x:String>
                                                <x:String>Extrema</x:String>
                                                <x:String>Cultural</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                                </VerticalStackLayout>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0" Padding="0,12,0,0">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                                        <Label Text="Atracción activa" FontAttributes="Bold" FontSize="13"/>
                                        <Label Text="Las inactivas no aparecen en el catálogo ni en el test guiado." FontSize="11"
                                               TextColor="{AppThemeBinding Light=#8b93a1, Dark={StaticResource Gray400}}"/>
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="1" x:Name="switchActiva" IsToggled="True" VerticalOptions="Center"/>
                                </Grid>
                                <BoxView HeightRequest="1" Margin="0,-6,0,0" BackgroundColor="{AppThemeBinding Light=#edeff3, Dark={StaticResource Gray600}}"/>
                            </VerticalStackLayout>

                            <!-- pestaña: restricciones -->
                            <VerticalStackLayout x:Name="panelRestricciones" Spacing="10" IsVisible="False">
                                <Label Text="Permitido por grupo de discapacidad" FontAttributes="Bold" FontSize="15"/>
                                <Label Text="Apaga el permiso de un grupo si esta atracción está bloqueada para él."
                                       FontSize="11.5" TextColor="{AppThemeBinding Light=#8b93a1, Dark={StaticResource Gray400}}"/>
                                <CollectionView x:Name="collectionGrupos" ItemsSource="{Binding Grupos}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,auto" Padding="0,6">
                                                <Label Grid.Column="0" Text="{Binding Nombre}" FontSize="13.5" VerticalOptions="Center"/>
                                                <Switch Grid.Column="1" IsToggled="{Binding Permitido}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                                <Label Text="Permitido por condición médica" FontAttributes="Bold" FontSize="15" Margin="0,8,0,0"/>
                                <CollectionView x:Name="collectionCondiciones" ItemsSource="{Binding Condiciones}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,auto" Padding="0,6">
                                                <Label Grid.Column="0" Text="{Binding Nombre}" FontSize="13.5" VerticalOptions="Center"/>
                                                <Switch Grid.Column="1" IsToggled="{Binding Permitido}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Grid>
                    </ScrollView>

                    <!-- pie: acción compartida por las dos pestañas -->
                    <Grid Grid.Row="3" Padding="22,12" RowDefinitions="Auto">
                        <Button Text="Guardar cambios"
                                FontSize="15"
                                FontAttributes="Bold"
                                BackgroundColor="#0F6B5C"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="48"
                                Clicked="OnGuardarClicked"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
