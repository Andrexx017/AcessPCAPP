<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:AppParque.Shared"
             x:Class="AppParque.Features.Administracion.AdminZonas.AdminZonaEditView"
             Title="Zona"
             BackgroundColor="{AppThemeBinding Light=#f5f7fa, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <shared:ThemeSwitchView />

            <VerticalStackLayout x:Name="panelCodigoNuevo">
                <Label Text="Código (único, ej. &quot;consentimientos&quot;):" FontAttributes="Bold"/>
                <Entry x:Name="entryCodigo" Placeholder="codigo_zona"/>
            </VerticalStackLayout>

            <Label x:Name="lblCodigoExistente" FontSize="12" IsVisible="False"
                   TextColor="{AppThemeBinding Light=#8b93a1, Dark={StaticResource Gray400}}"/>

            <VerticalStackLayout>
                <Label Text="Nombre:" FontAttributes="Bold"/>
                <Entry x:Name="entryNombre" Placeholder="Nombre completo de la zona"/>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="Nombre corto (para el mapa):" FontAttributes="Bold"/>
                <Entry x:Name="entryCorto" Placeholder="Ej. Tronco"/>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="Nota de ayuda:" FontAttributes="Bold"/>
                <Editor x:Name="editorNota" AutoSize="TextChanges" Placeholder="Lo que se explica al personal antes de evaluar la zona."/>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="Resumen &quot;sin novedad&quot;:" FontAttributes="Bold"/>
                <Editor x:Name="editorResumenSinNovedad" AutoSize="TextChanges" Placeholder="Lo que se muestra cuando la zona queda sin novedad."/>
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <Label Text="Permite &quot;sin novedad&quot;:" FontAttributes="Bold" VerticalOptions="Center"/>
                <Switch x:Name="switchPermiteSinNovedad" IsToggled="True"/>
            </HorizontalStackLayout>

            <VerticalStackLayout>
                <Label Text="Orden:" FontAttributes="Bold"/>
                <Entry x:Name="entryOrden" Keyboard="Numeric" Placeholder="0"/>
            </VerticalStackLayout>

            <HorizontalStackLayout x:Name="panelActiva" Spacing="10" IsVisible="False">
                <Label Text="Activa:" FontAttributes="Bold" VerticalOptions="Center"/>
                <Switch x:Name="switchActiva" IsToggled="True"/>
            </HorizontalStackLayout>

            <Button Text="Guardar"
                    FontSize="18"
                    Margin="0,10,0,0"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="20"
                    HeightRequest="45"
                    Clicked="OnGuardarClicked"/>

            <Button x:Name="btnEliminarZona" Text="Eliminar zona"
                    FontSize="14"
                    BackgroundColor="Transparent"
                    TextColor="#C0392B"
                    IsVisible="False"
                    Clicked="OnEliminarZonaClicked"/>

            <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#edeff3, Dark={StaticResource Gray600}}" Margin="0,10"
                     x:Name="separadorPreguntas" IsVisible="False"/>

            <Grid x:Name="panelPreguntas" ColumnDefinitions="*,auto" IsVisible="False">
                <Label Grid.Column="0" Text="Preguntas" FontAttributes="Bold" FontSize="16" VerticalOptions="Center"/>
                <Button Grid.Column="1" Text="+ Pregunta" FontSize="13"
                        BackgroundColor="{AppThemeBinding Light=#eef1fb, Dark={StaticResource Gray900}}"
                        TextColor="{AppThemeBinding Light=#3949ab, Dark={StaticResource SecondaryDarkText}}"
                        Clicked="OnNuevaPreguntaClicked"/>
            </Grid>

            <CollectionView x:Name="collectionPreguntas" ItemsSource="{Binding Preguntas}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="10" Padding="10" Margin="0,0,0,8" BorderColor="{AppThemeBinding Light=#edeff3, Dark={StaticResource Gray600}}">
                            <Grid ColumnDefinitions="*,auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="13.5"/>
                                        <Label Text="informativa" FontSize="10" IsVisible="{Binding EsInformativa}"
                                               TextColor="White" BackgroundColor="#0F6B5C" Padding="6,1"/>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Clave}" FontSize="11" TextColor="{AppThemeBinding Light=#8b93a1, Dark={StaticResource Gray400}}"/>
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding Activa}" VerticalOptions="Center"/>
                            </Grid>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPreguntaTapped" CommandParameter="{Binding .}"/>
                            </Frame.GestureRecognizers>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
