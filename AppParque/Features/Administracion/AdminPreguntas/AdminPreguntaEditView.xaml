<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:AppParque.Shared"
             x:Class="AppParque.Features.Administracion.AdminPreguntas.AdminPreguntaEditView"
             Title="Pregunta"
             BackgroundColor="{AppThemeBinding Light=#f5f7fa, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <shared:ThemeSwitchView />

            <VerticalStackLayout>
                <Label Text="Texto de la pregunta:" FontAttributes="Bold"/>
                <Editor x:Name="editorTexto" AutoSize="TextChanges" Placeholder="¿El visitante puede...?"/>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="Tipo:" FontAttributes="Bold"/>
                <Picker x:Name="pickerTipo" Title="Seleccione...">
                    <Picker.Items>
                        <x:String>Única selección</x:String>
                        <x:String>Selección múltiple</x:String>
                    </Picker.Items>
                </Picker>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="Orden:" FontAttributes="Bold"/>
                <Entry x:Name="entryOrden" Keyboard="Numeric" Placeholder="0"/>
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <Label Text="Activa:" FontAttributes="Bold" VerticalOptions="Center"/>
                <Switch x:Name="switchActiva" IsToggled="True"/>
            </HorizontalStackLayout>

            <Button Text="Guardar"
                    FontSize="18"
                    Margin="0,10,0,0"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="20"
                    HeightRequest="45"
                    Clicked="OnGuardarClicked"/>

            <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#edeff3, Dark={StaticResource Gray600}}" Margin="0,10"/>

            <Grid ColumnDefinitions="*,auto">
                <Label Grid.Column="0" Text="Opciones de respuesta" FontAttributes="Bold" FontSize="16" VerticalOptions="Center"/>
                <Button Grid.Column="1" Text="+ Opción" FontSize="13"
                        BackgroundColor="{AppThemeBinding Light=#eef1fb, Dark={StaticResource Gray900}}"
                        TextColor="{AppThemeBinding Light=#3949ab, Dark={StaticResource SecondaryDarkText}}"
                        Clicked="OnAgregarOpcionClicked"/>
            </Grid>

            <CollectionView x:Name="collectionOpciones" ItemsSource="{Binding Opciones}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="10" Padding="10" Margin="0,0,0,8" BorderColor="{AppThemeBinding Light=#edeff3, Dark={StaticResource Gray600}}">
                            <Grid ColumnDefinitions="*,auto,auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding Texto}" FontAttributes="Bold" FontSize="13.5"/>
                                    <Label Text="{Binding Codigo}" FontSize="11" TextColor="{AppThemeBinding Light=#8b93a1, Dark={StaticResource Gray400}}"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="✏️" FontSize="14" Padding="6" BackgroundColor="{AppThemeBinding Light=#f5f7fa, Dark={StaticResource Gray900}}"
                                        Clicked="OnEditarOpcionClicked" CommandParameter="{Binding .}"/>
                                <Button Grid.Column="2" Text="🗑️" FontSize="14" Padding="6" BackgroundColor="{AppThemeBinding Light=#f5f7fa, Dark={StaticResource Gray900}}"
                                        Clicked="OnEliminarOpcionClicked" CommandParameter="{Binding .}"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
