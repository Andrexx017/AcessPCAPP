<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppParque.Features.Auth.LoginView"
             BackgroundColor="#f5f7fa"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="auto, auto, auto, auto, *"
          Padding="30"
          RowSpacing="15">

        <!-- Logo -->
        <Image Grid.Row="0"
               Source="logo.png"
               WidthRequest="250"
               HeightRequest="200"
               HorizontalOptions="Center"
               VerticalOptions="End"
               Margin="0,60,0,45"/>

        <!-- Campo Usuario -->
        <Border Grid.Row="2"
                Stroke="#e0e0e0"
                StrokeThickness="2"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 30"
                Padding="15"
                Margin="0,10">
            <Grid ColumnDefinitions="auto,*"
                  VerticalOptions="Center">

                <Image WidthRequest="24" HeightRequest="24" VerticalOptions="Center"
                       Source="user_icon.png"/>
                <!-- Ícono reemplazable -->

                <Entry x:Name="entryUser"
                       Grid.Column="1"
                       Placeholder="Usuario"
                       FontSize="16"
                       TextColor="#222"
                       PlaceholderColor="#999"
                       BackgroundColor="Transparent"
                       Margin="10,0,0,0"
                       HorizontalOptions="FillAndExpand"
                       VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- Campo Contraseña -->
        <Border Grid.Row="3"
                Stroke="#e0e0e0"
                StrokeThickness="2"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 30"
                Padding="15"
                Margin="0,10">
            <Grid ColumnDefinitions="auto,*,auto"
                  VerticalOptions="Center">

                <!-- Ícono Candado -->
                <Image WidthRequest="24" HeightRequest="24" VerticalOptions="Center"
                       Source="lock_icon.png"/>
                <!-- Ícono reemplazable -->

                <!-- Entry -->
                <Entry x:Name="entryPassword"
                       Grid.Column="1"
                       Placeholder="Contraseña"
                       IsPassword="True"
                       FontSize="16"
                       TextColor="#222"
                       PlaceholderColor="#999"
                       BackgroundColor="Transparent"
                       Margin="10,0,0,0"
                       HorizontalOptions="FillAndExpand"
                       VerticalOptions="Center"/>

                <!-- Botón Mostrar/Ocultar -->
                <ImageButton Grid.Column="2"
                             x:Name="btnTogglePassword"
                             Source="eye_open.png"
                             WidthRequest="20"
                             HeightRequest="20"
                             BackgroundColor="Transparent"
                             Clicked="OnTogglePasswordClicked"/>
            </Grid>
        </Border>

        <!-- Botón Iniciar sesión -->
        <Button Grid.Row="4"
                Text="Iniciar sesión"
                WidthRequest="180"
                HeightRequest="50"
                CornerRadius="25"
                FontSize="16"
                BackgroundColor="#4CAF50"
                TextColor="White"
                VerticalOptions="Start"
                HorizontalOptions="Center"
                Clicked="OnLoginClicked">
            <Button.Shadow>
                <Shadow Brush="Black"
                        Offset="3,3"
                        Radius="8"
                        Opacity="0.3" />
            </Button.Shadow>
        </Button>

    </Grid>
</ContentPage>
