<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppParque.Features.Historial.HistorialView"
             Title="Historial"
             BackgroundColor="#f5f7fa">

    <Grid RowDefinitions="Auto,Auto,*" Padding="12">

        <Label Text="Historial de Tests"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="#222"
               Margin="0,0,0,8"/>

        <SearchBar Grid.Row="1"
                   Placeholder="Buscar por nombre o ID"
                   TextChanged="OnSearchTextChanged"
                   Margin="0,0,0,8"
                   BackgroundColor="White"
                   TextColor="Black"/>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Historial}">
            <CollectionView.EmptyView>
                <Label Text="Sin registros"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="#666"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,6"
                           Padding="12"
                           CornerRadius="12"
                           BorderColor="#ddd"
                           BackgroundColor="White">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding VisitorName}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding VisitorId}" FontSize="13" />
                            <Label Text="{Binding NurseName, StringFormat='Atendido por: {0}'}" FontSize="13" />
                            <Label Text="{Binding Date, StringFormat='Fecha: {0}'}" FontSize="13" />
                            <Label Text="{Binding Stature, StringFormat='Estatura: {0} cm'}" FontSize="13" />
                            <Label Text="{Binding Answers, StringFormat='Respuestas: {0}'}"
                                   FontSize="12"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
