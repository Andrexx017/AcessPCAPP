<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:AppParque.Shared"
             x:Class="AppParque.Features.EvaluacionAccesibilidad.MapaCapacidadesView"
             Title="Mapa de capacidades"
             BackgroundColor="{AppThemeBinding Light=#f5f7fa, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- cabecera -->
        <Border Grid.Row="0"
                Padding="16,12"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{Binding NombreVisitante}"
                           FontAttributes="Bold" FontSize="16"
                           TextColor="{AppThemeBinding Light=#1f2430, Dark=White}" />
                    <Label Text="{Binding Avance}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#8b93a1, Dark={StaticResource Gray400}}" />
                </VerticalStackLayout>

                <Label Grid.Column="1"
                       Text="{Binding Dimensiones}"
                       FontAttributes="Bold" FontSize="13"
                       VerticalOptions="Center"
                       TextColor="#0F6B5C" />

                <shared:ThemeSwitchView Grid.Column="2" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- el mapa -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14,16,18" Spacing="14">

                <Label Text="Toque la parte del cuerpo que quiere revisar."
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#6b7280, Dark={StaticResource Gray400}}" />

                <AbsoluteLayout x:Name="Lienzo"
                                WidthRequest="358"
                                HeightRequest="540"
                                HorizontalOptions="Center"
                                BindableLayout.ItemsSource="{Binding ZonasCuerpo}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border AbsoluteLayout.LayoutBounds="{Binding Bounds}"
                                    BackgroundColor="{Binding Fondo}"
                                    Stroke="{Binding Trazo}"
                                    StrokeThickness="{Binding Grosor}"
                                    StrokeDashArray="{Binding Guiones}"
                                    StrokeDashOffset="0"
                                    Padding="2"
                                    SemanticProperties.Description="{Binding Descripcion}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="{Binding Radio}" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnZonaTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Etiqueta}"
                                       TextColor="{Binding ColorTexto}"
                                       FontSize="10.5"
                                       FontAttributes="Bold"
                                       LineBreakMode="WordWrap"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </AbsoluteLayout>

                <!-- lo que no está en el cuerpo -->
                <Label Text="LO QUE NO ESTÁ EN EL CUERPO"
                       FontSize="10.5" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#8b93a1, Dark={StaticResource Gray400}}" />

                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding ZonasAparte}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{Binding Fondo}"
                                    Stroke="{Binding Trazo}"
                                    StrokeThickness="{Binding Grosor}"
                                    StrokeDashArray="{Binding Guiones}"
                                    Padding="13,11"
                                    MinimumHeightRequest="52"
                                    SemanticProperties.Description="{Binding Descripcion}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnZonaTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding Etiqueta}"
                                           TextColor="{Binding ColorTexto}"
                                           FontSize="14" FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Rotulo}"
                                           TextColor="{Binding ColorTexto}"
                                           FontSize="11"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- leyenda -->
                <FlexLayout Wrap="Wrap" JustifyContent="Center" AlignItems="Center">
                    <HorizontalStackLayout Spacing="6" Margin="0,4,14,0">
                        <Border BackgroundColor="#E7F1EF" Stroke="#0F6B5C" StrokeThickness="2" WidthRequest="12" HeightRequest="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="3" /></Border.StrokeShape>
                        </Border>
                        <Label Text="Sin novedad" FontSize="11"
                               TextColor="{AppThemeBinding Light=#6b7280, Dark={StaticResource Gray400}}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6" Margin="0,4,14,0">
                        <Border BackgroundColor="#E3EBF5" Stroke="#1B4E8A" StrokeThickness="2" WidthRequest="12" HeightRequest="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="3" /></Border.StrokeShape>
                        </Border>
                        <Label Text="Evaluada" FontSize="11"
                               TextColor="{AppThemeBinding Light=#6b7280, Dark={StaticResource Gray400}}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6" Margin="0,4,14,0">
                        <Border BackgroundColor="#FDF8EC" Stroke="#D9A400" StrokeThickness="2" WidthRequest="12" HeightRequest="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="3" /></Border.StrokeShape>
                        </Border>
                        <Label Text="A medias" FontSize="11"
                               TextColor="{AppThemeBinding Light=#6b7280, Dark={StaticResource Gray400}}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                        <Border BackgroundColor="#FAFBFC" Stroke="#C6CED7" StrokeThickness="2" WidthRequest="12" HeightRequest="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="3" /></Border.StrokeShape>
                        </Border>
                        <Label Text="Sin revisar" FontSize="11"
                               TextColor="{AppThemeBinding Light=#6b7280, Dark={StaticResource Gray400}}" />
                    </HorizontalStackLayout>
                </FlexLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- pie -->
        <Border Grid.Row="2"
                Padding="16,10,16,14"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                    <Label Text="{Binding Pie}"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1f2430, Dark=White}" />
                    <Label Text="de 29 atracciones"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light=#8b93a1, Dark={StaticResource Gray400}}" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="{Binding TextoBotonPie}"
                        Clicked="OnPieClicked"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        BackgroundColor="#0F6B5C"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="14.5"
                        CornerRadius="12"
                        MinimumHeightRequest="48"
                        Padding="17,0" />
            </Grid>
        </Border>

        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="#0F6B5C"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
