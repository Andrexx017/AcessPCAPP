<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:AppParque.Shared"
             x:Class="AppParque.Features.EvaluacionAccesibilidad.MapaCapacidadesEscritorioView"
             Title="Mapa de capacidades"
             BackgroundColor="{AppThemeBinding Light=#f5f7fa, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="Auto,*">

        <!-- barra superior -->
        <Border Grid.Row="0"
                Padding="28,14"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="18">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding NombreVisitante}"
                           FontAttributes="Bold" FontSize="17"
                           TextColor="{AppThemeBinding Light=#1f2430, Dark=White}" />
                    <Label Text="{Binding Avance}"
                           FontSize="12.5"
                           TextColor="{AppThemeBinding Light=#8b93a1, Dark={StaticResource Gray400}}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label Text="{Binding Dimensiones}"
                           FontAttributes="Bold" FontSize="19"
                           HorizontalTextAlignment="End"
                           TextColor="#0F6B5C" />
                    <Label Text="dimensiones"
                           FontSize="10.5"
                           HorizontalTextAlignment="End"
                           TextColor="{AppThemeBinding Light=#8b93a1, Dark={StaticResource Gray400}}" />
                </VerticalStackLayout>

                <Button Grid.Column="2"
                        Text="Ver dictamen"
                        Clicked="OnDictamenClicked"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        BackgroundColor="#0F6B5C"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="14.5"
                        CornerRadius="11"
                        MinimumHeightRequest="46"
                        Padding="18,0" />

                <shared:ThemeSwitchView Grid.Column="3" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- dos paneles: el mapa y la zona abierta -->
        <Grid x:Name="Paneles"
              Grid.Row="1"
              Padding="28,22"
              ColumnSpacing="22"
              RowSpacing="22">

            <!-- panel izquierdo: el mapa -->
            <ScrollView x:Name="PanelMapa">
                <VerticalStackLayout Spacing="13">

                    <Border Padding="16"
                            BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
                            Stroke="{AppThemeBinding Light=#e3e7ec, Dark={StaticResource Gray600}}"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Zonas del cuerpo"
                                       FontAttributes="Bold" FontSize="14.5"
                                       TextColor="{AppThemeBinding Light=#1f2430, Dark=White}" />
                                <Label Grid.Column="1" Text="{Binding Avance}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#8b93a1, Dark={StaticResource Gray400}}" />
                            </Grid>

                            <AbsoluteLayout WidthRequest="358"
                                            HeightRequest="540"
                                            HorizontalOptions="Center"
                                            BindableLayout.ItemsSource="{Binding ZonasCuerpo}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border AbsoluteLayout.LayoutBounds="{Binding Bounds}"
                                                BackgroundColor="{Binding Fondo}"
                                                Stroke="{Binding Trazo}"
                                                StrokeThickness="{Binding Grosor}"
                                                StrokeDashArray="{Binding Guiones}"
                                                StrokeDashOffset="0"
                                                Padding="2"
                                                SemanticProperties.Description="{Binding Descripcion}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="{Binding Radio}" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnZonaTapped" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding Etiqueta}"
                                                   TextColor="{Binding ColorTexto}"
                                                   FontSize="10.5"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="WordWrap"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </AbsoluteLayout>

                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light=#edeff3, Dark={StaticResource Gray600}}" />

                            <FlexLayout Wrap="Wrap" AlignItems="Center">
                                <HorizontalStackLayout Spacing="6" Margin="0,2,14,0">
                                    <Border BackgroundColor="#E7F1EF" Stroke="#0F6B5C" StrokeThickness="2" WidthRequest="12" HeightRequest="12">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="3" /></Border.StrokeShape>
                                    </Border>
                                    <Label Text="Sin novedad" FontSize="11"
                                           TextColor="{AppThemeBinding Light=#6b7280, Dark={StaticResource Gray400}}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="6" Margin="0,2,14,0">
                                    <Border BackgroundColor="#E3EBF5" Stroke="#1B4E8A" StrokeThickness="2" WidthRequest="12" HeightRequest="12">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="3" /></Border.StrokeShape>
                                    </Border>
                                    <Label Text="Evaluada" FontSize="11"
                                           TextColor="{AppThemeBinding Light=#6b7280, Dark={StaticResource Gray400}}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="6" Margin="0,2,14,0">
                                    <Border BackgroundColor="#FDF8EC" Stroke="#D9A400" StrokeThickness="2" WidthRequest="12" HeightRequest="12">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="3" /></Border.StrokeShape>
                                    </Border>
                                    <Label Text="A medias" FontSize="11"
                                           TextColor="{AppThemeBinding Light=#6b7280, Dark={StaticResource Gray400}}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="6" Margin="0,2,14,0">
                                    <Border BackgroundColor="#FAFBFC" Stroke="#C6CED7" StrokeThickness="2" WidthRequest="12" HeightRequest="12">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="3" /></Border.StrokeShape>
                                    </Border>
                                    <Label Text="Sin revisar" FontSize="11"
                                           TextColor="{AppThemeBinding Light=#6b7280, Dark={StaticResource Gray400}}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                                    <Border BackgroundColor="#15191E" StrokeThickness="0" WidthRequest="12" HeightRequest="12">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="3" /></Border.StrokeShape>
                                    </Border>
                                    <Label Text="Abierta" FontSize="11"
                                           TextColor="{AppThemeBinding Light=#6b7280, Dark={StaticResource Gray400}}" />
                                </HorizontalStackLayout>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- lo que no está en el cuerpo -->
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding ZonasAparte}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{Binding Fondo}"
                                        Stroke="{Binding Trazo}"
                                        StrokeThickness="{Binding Grosor}"
                                        StrokeDashArray="{Binding Guiones}"
                                        Padding="13,11"
                                        MinimumHeightRequest="56"
                                        SemanticProperties.Description="{Binding Descripcion}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnZonaTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding Etiqueta}"
                                               TextColor="{Binding ColorTexto}"
                                               FontSize="14" FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Rotulo}"
                                               TextColor="{Binding ColorTexto}"
                                               FontSize="11.5"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- panel derecho: la zona abierta, con todas sus preguntas -->
            <Border x:Name="PanelZona"
                    Padding="24,22"
                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
                    Stroke="{AppThemeBinding Light=#e3e7ec, Dark={StaticResource Gray600}}"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <Grid>
                    <!-- sin zona abierta -->
                    <VerticalStackLayout x:Name="VacioZona"
                                         Spacing="8"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="Elija una zona del cuerpo"
                               FontAttributes="Bold" FontSize="19"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#1f2430, Dark=White}" />
                        <Label Text="Sus preguntas aparecen aquí, sin perder de vista el mapa."
                               FontSize="13"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#6b7280, Dark={StaticResource Gray400}}" />
                    </VerticalStackLayout>

                    <!-- zona abierta -->
                    <ScrollView x:Name="ContenidoZona" IsVisible="False">
                        <VerticalStackLayout Spacing="16">

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding Nombre}"
                                           FontAttributes="Bold" FontSize="25"
                                           TextColor="{AppThemeBinding Light=#1f2430, Dark=White}" />
                                    <Label Text="{Binding Nota}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light=#6b7280, Dark={StaticResource Gray400}}" />
                                    <Label Text="{Binding Contador}"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="#0F6B5C" />
                                </VerticalStackLayout>

                                <Button Grid.Column="1"
                                        Text="Marcar sin novedad"
                                        Clicked="OnSinNovedadClicked"
                                        IsVisible="{Binding PermiteSinNovedad}"
                                        VerticalOptions="Start"
                                        BackgroundColor="#E7F1EF"
                                        BorderColor="#0F6B5C"
                                        BorderWidth="2"
                                        TextColor="#0A4D42"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        CornerRadius="12"
                                        MinimumHeightRequest="48"
                                        Padding="16,0" />
                            </Grid>

                            <Label IsVisible="{Binding ExigeLlenado}"
                                   Text="Esta zona son datos del visitante, no condiciones: no hay un valor normal por omisión, hay que llenarla."
                                   FontSize="12"
                                   TextColor="#8A5A00" />

                            <Label IsVisible="{Binding EstaSinNovedad}"
                                   Text="Zona marcada sin novedad: sus dimensiones quedaron como normales. Responder cualquier pregunta deshace la marca."
                                   FontSize="12"
                                   TextColor="#0A4D42" />

                            <!-- las preguntas de la zona, todas a la vez -->
                            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Preguntas}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="15"
                                                BackgroundColor="{AppThemeBinding Light=#fbfcfd, Dark={StaticResource Gray950}}"
                                                Stroke="{AppThemeBinding Light=#e3e7ec, Dark={StaticResource Gray600}}"
                                                StrokeThickness="1">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="13" />
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="10">

                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <Label Grid.Column="0" Text="{Binding Titulo}"
                                                           FontAttributes="Bold" FontSize="15"
                                                           TextColor="{AppThemeBinding Light=#1f2430, Dark=White}" />
                                                    <Border Grid.Column="1"
                                                            IsVisible="{Binding TieneEje}"
                                                            BackgroundColor="{Binding EjeColor}"
                                                            StrokeThickness="0"
                                                            Padding="6,3"
                                                            VerticalOptions="Start">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape>
                                                        <Label Text="{Binding EjeTexto}" FontSize="9.5" FontAttributes="Bold" TextColor="White" />
                                                    </Border>
                                                </Grid>

                                                <FlexLayout IsVisible="{Binding EsOpciones}"
                                                            Wrap="Wrap"
                                                            BindableLayout.ItemsSource="{Binding Opciones}">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,7,7"
                                                                    Padding="14,0"
                                                                    MinimumHeightRequest="46"
                                                                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
                                                                    Stroke="{Binding Trazo}"
                                                                    StrokeThickness="{Binding Grosor}"
                                                                    SemanticProperties.Description="{Binding Texto}">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="10" />
                                                                </Border.StrokeShape>
                                                                <Border.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="OnOpcionTapped" />
                                                                </Border.GestureRecognizers>
                                                                <Label Text="{Binding Texto}"
                                                                       FontSize="13.5"
                                                                       FontAttributes="{Binding Peso}"
                                                                       TextColor="{Binding ColorTexto}"
                                                                       VerticalOptions="Center" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </FlexLayout>

                                                <Grid IsVisible="{Binding EsNumero}" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <Entry Grid.Column="0"
                                                           Text="{Binding Valor, Mode=TwoWay}"
                                                           Keyboard="Numeric"
                                                           FontSize="19"
                                                           MinimumHeightRequest="48"
                                                           BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
                                                           TextColor="{AppThemeBinding Light=#1f2430, Dark=White}" />
                                                    <Label Grid.Column="1" Text="{Binding Unidad}"
                                                           FontSize="14"
                                                           VerticalOptions="Center"
                                                           TextColor="{AppThemeBinding Light=#6b7280, Dark={StaticResource Gray400}}" />
                                                </Grid>

                                                <Label Text="{Binding Ayuda}"
                                                       IsVisible="{Binding TieneAyuda}"
                                                       FontSize="11.5"
                                                       TextColor="{AppThemeBinding Light=#6b7280, Dark={StaticResource Gray400}}" />

                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Button Text="Siguiente zona"
                                    Clicked="OnSiguienteZonaClicked"
                                    BackgroundColor="#0F6B5C"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    CornerRadius="12"
                                    MinimumHeightRequest="50" />

                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>

        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="#0F6B5C"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <shared:AsistenteFlotanteView Grid.Row="1"/>
    </Grid>
</ContentPage>
