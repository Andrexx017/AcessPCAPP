<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:AppParque.Shared"
             x:Class="AppParque.Features.EvaluacionAccesibilidad.TestView"
             Title="Test de Atracciones">

    <ContentPage.Content>
        <StackLayout Padding="20" Spacing="12">

            <shared:ThemeSwitchView />

            <Label Text="{Binding ProgressText}" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" />

            <Label Text="{Binding CurrentQuestionText}" FontAttributes="Bold" FontSize="20" />

            <ScrollView HeightRequest="250">
                <StackLayout BindableLayout.ItemsSource="{Binding CurrentOptions}" 
                             Spacing="10" Padding="5">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame CornerRadius="12" Padding="8" HasShadow="True">
                                <HorizontalStackLayout Spacing="10">
                                    <CheckBox CheckedChanged="OnOptionCheckedChanged" />
                                    <Label Text="{Binding Texto}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </StackLayout>
            </ScrollView>

            <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="20">
                <Button Text="Anterior" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanGoBack}"/>
                <Button Text="Siguiente" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}"/>
            </StackLayout>

        </StackLayout>
    </ContentPage.Content>
</ContentPage>
